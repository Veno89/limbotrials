{
  "name": "everlasting-oblivion-limbo-trial",
  "version": "0.1.0",
  "description": "A browser-playable dark fantasy arena roguelite prototype.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veno89/limbotrials.git"
  },
  "bugs": {
    "url": "https://github.com/Veno89/limbotrials/issues"
  },
  "homepage": "https://github.com/Veno89/limbotrials#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p netlify/functions/tsconfig.json --pretty false",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "runs:index": "node scripts/index-runs.mjs",
    "analytics:latest": "node --env-file-if-exists=.env scripts/latest-runs.mjs",
    "lint": "eslint src netlify/functions"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vvfx/phaser-runtime": "file:vendor/vvfx-phaser-runtime-0.16.0.tgz",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "eslint": "^9.28.0",
    "playwright-core": "^1.60.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
