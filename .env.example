# Public browser variables. Use the Supabase publishable key when available.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Netlify Function variables. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
ALLOWED_ORIGIN=https://limbotrials.netlify.app
